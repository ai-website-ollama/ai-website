# Ollama AI Website Configuration

# Ollama API URL - Change this to your Ollama instance URL
OLLAMA_URL=http://192.168.10.181:11434

# Server port
PORT=3000

# Session secret - Generate a new one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-random-string

# Environment mode (development or production)
NODE_ENV=development
